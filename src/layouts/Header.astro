---
const currentPath = Astro.url.pathname;

// Function to check if a path is active
const isActive = (path: string) => {
    if (path === "/" && currentPath === "/") return true;
    if (path !== "/" && currentPath.startsWith(path)) return true;
    return false;
};

// Function to get the class for navigation links
const getNavLinkClass = (path: string) => {
    const baseClass = "flex items-center text-lg font-medium transition-colors";
    const activeClass = "text-primary";
    const inactiveClass = "text-foreground/60 hover:text-foreground/80";

    return `${baseClass} ${isActive(path) ? activeClass : inactiveClass}`;
};

// Function to get the class for footer links
const getFooterLinkClass = (path: string) => {
    const baseClass = "hover:text-foreground";
    const activeClass = "text-primary";
    const inactiveClass = "text-muted-foreground";

    return `${baseClass} ${isActive(path) ? activeClass : inactiveClass}`;
};
---

<header class="sticky top-0 z-40 w-full border-b bg-background">
    <div
        class="container flex h-16 items-center space-x-4 sm:justify-between sm:space-x-0"
    >
        <div class="flex gap-6 md:gap-10">
            <a href="/" class="flex items-center space-x-2">
                <img
                    src="/hamro-blog-logo.png"
                    alt="hamro.blog Logo"
                    class="h-10 w-auto"
                />
            </a>
        </div>
        <div class="flex flex-1 items-center justify-end space-x-4">
            <nav class="hidden gap-6 md:flex">
                <a href="/" class={getNavLinkClass("/")}>Home</a>
                <a href="/blogs" class={getNavLinkClass("/blogs")}>Blogs</a>
                <a href="/authors" class={getNavLinkClass("/authors")}
                    >Authors</a
                >
                <a href="/about" class={getNavLinkClass("/about")}>About</a>
            </nav>
            <button
                id="mobile-menu-button"
                type="button"
                aria-controls="mobile-menu"
                aria-expanded="false"
                aria-label="Toggle navigation menu"
                class="inline-flex items-center justify-center rounded-md p-2 text-foreground/60 hover:bg-accent hover:text-foreground md:hidden"
            >
                <svg
                    id="mobile-menu-icon-open"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="18" y2="18"></line>
                </svg>
                <svg
                    id="mobile-menu-icon-close"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="hidden"
                >
                    <line x1="18" x2="6" y1="6" y2="18"></line>
                    <line x1="6" x2="18" y1="6" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
    <nav
        id="mobile-menu"
        class="hidden flex-col gap-1 border-t bg-background px-4 py-3 md:hidden"
    >
        <a href="/" class={`${getNavLinkClass("/")} py-2`}>Home</a>
        <a href="/blogs" class={`${getNavLinkClass("/blogs")} py-2`}>Blogs</a>
        <a href="/authors" class={`${getNavLinkClass("/authors")} py-2`}
            >Authors</a
        >
        <a href="/about" class={`${getNavLinkClass("/about")} py-2`}>About</a>
    </nav>
</header>

<script>
    const menuButton = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("mobile-menu-icon-open");
    const iconClose = document.getElementById("mobile-menu-icon-close");

    const setMenuOpen = (open: boolean) => {
        menuButton?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("hidden", !open);
        menu?.classList.toggle("flex", open);
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
    };

    menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
    });

    window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) setMenuOpen(false);
    });
</script>
