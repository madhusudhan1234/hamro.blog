---
import MainLayout from "../../layouts/MainLayout.astro";
import { articles, getArticleWithAuthor } from "../../data/articles";

const allArticles = [...articles]
	.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
	.map(getArticleWithAuthor);
---

<MainLayout title="Blogs" description="Browse all articles shared by our developer community.">
	<section class="py-12 md:py-16">
		<div class="container">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
					All Blogs
				</h1>
				<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
					Explore articles and excerpts shared by developers in our
					community.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{
					allArticles.map((article) => (
						<div class="group relative overflow-hidden rounded-lg border bg-background shadow-sm transition-all hover:shadow-md">
							<a
								href={`/blogs/${article.id}`}
								class="absolute inset-0 z-10"
							/>
							<div class="aspect-video overflow-hidden">
								<img
									src={article.image}
									alt={article.title}
									class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								/>
							</div>
							<div class="p-6">
								<div class="flex items-center gap-2 mb-3">
									{article.tags.slice(0, 2).map((tag) => (
										<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
											{tag}
										</span>
									))}
								</div>
								<h3 class="text-xl font-bold leading-tight mb-2 line-clamp-2">
									{article.title}
								</h3>
								<p class="text-muted-foreground mb-4 line-clamp-2">
									{article.excerpt}
								</p>
								<div class="flex items-center justify-between">
									<div class="flex items-center gap-2">
										<img
											src={article.author.avatar}
											alt={article.author.name}
											class="h-8 w-8 rounded-full object-cover"
										/>
										<span class="text-sm font-medium">
											{article.author.name}
										</span>
									</div>
									<span class="text-xs text-muted-foreground">
										{article.date}
									</span>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>
</MainLayout>
