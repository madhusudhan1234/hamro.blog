---
import MainLayout from "../../layouts/MainLayout.astro";
import { authors, getAuthorById } from "../../data/authors";
import { getArticlesByAuthor } from "../../data/articles";

export function getStaticPaths() {
	return authors.map((author) => ({
		params: { id: String(author.id) },
	}));
}

const { id } = Astro.params;
const author = getAuthorById(Number(id))!;
const authorArticles = getArticlesByAuthor(author.id);
---

<MainLayout title={author.name} description={author.bio}>
	<section class="py-12 md:py-16">
		<div class="container">
			<div class="flex flex-col items-center text-center mb-12">
				<img
					src={author.avatar}
					alt={author.name}
					class="h-32 w-32 rounded-full object-cover mb-4"
				/>
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-1">
					{author.name}
				</h1>
				<p class="text-primary font-medium mb-3">{author.role}</p>
				<p class="text-muted-foreground max-w-xl">{author.bio}</p>
				<p class="text-sm text-muted-foreground mt-4">
					{authorArticles.length} Articles Published
				</p>
			</div>

			<h2 class="text-2xl font-bold tracking-tight mb-6">
				Articles by {author.name}
			</h2>

			{
				authorArticles.length === 0 ? (
					<p class="text-muted-foreground">
						No articles published yet.
					</p>
				) : (
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						{authorArticles.map((article) => (
							<div class="group relative overflow-hidden rounded-lg border bg-background shadow-sm transition-all hover:shadow-md">
								<a
									href={`/blogs/${article.id}`}
									class="absolute inset-0 z-10"
								/>
								<div class="aspect-video overflow-hidden">
									<img
										src={article.image}
										alt={article.title}
										class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
									/>
								</div>
								<div class="p-6">
									<div class="flex items-center gap-2 mb-3">
										{article.tags.slice(0, 2).map((tag) => (
											<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
												{tag}
											</span>
										))}
									</div>
									<h3 class="text-xl font-bold leading-tight mb-2 line-clamp-2">
										{article.title}
									</h3>
									<p class="text-muted-foreground mb-4 line-clamp-2">
										{article.excerpt}
									</p>
									<span class="text-xs text-muted-foreground">
										{article.date}
									</span>
								</div>
							</div>
						))}
					</div>
				)
			}
		</div>
	</section>
</MainLayout>
