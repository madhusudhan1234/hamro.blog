---
import MainLayout from "../layouts/MainLayout.astro";
import siteData from "../data/site.json";

const lastUpdated = "July 18, 2026";
---

<MainLayout
	title="Privacy Policy"
	description="Privacy Policy for hamro.blog."
>
	<section class="py-12 md:py-16">
		<div class="container max-w-3xl">
			<h1 class="text-4xl font-bold tracking-tight mb-2">
				Privacy Policy
			</h1>
			<p class="text-sm text-muted-foreground mb-10">
				Last updated: {lastUpdated}
			</p>

			<div class="space-y-8 text-muted-foreground leading-relaxed">
				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						1. Information We Collect
					</h2>
					<p>
						When you subscribe to our newsletter or contact us
						through the site, we collect the information you
						provide, such as your name and email address. We do
						not collect any information beyond what you choose to
						share with us.
					</p>
				</section>

				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						2. How We Use Your Information
					</h2>
					<p>
						We use the information you provide to respond to your
						messages, send newsletter updates you've subscribed
						to, and improve {siteData.name}. We do not sell your
						personal information to third parties.
					</p>
				</section>

				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						3. Cookies
					</h2>
					<p>
						{siteData.name} may use cookies to remember your
						preferences, such as light or dark mode, and to
						understand how visitors use the site.
					</p>
				</section>

				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						4. Third-Party Links
					</h2>
					<p>
						Articles on {siteData.name} link back to original
						content hosted on third-party sites. We are not
						responsible for the privacy practices of those
						external sites.
					</p>
				</section>

				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						5. Your Rights
					</h2>
					<p>
						You may request that we update or delete any personal
						information we hold about you, such as your
						newsletter subscription, at any time by contacting
						us.
					</p>
				</section>

				<section>
					<h2 class="text-xl font-bold text-foreground mb-2">
						6. Contact
					</h2>
					<p>
						Questions about this policy can be sent through our <a
							href="/contact"
							class="text-primary hover:underline">contact page</a
						>.
					</p>
				</section>
			</div>
		</div>
	</section>
</MainLayout>
